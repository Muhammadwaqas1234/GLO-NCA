# =============================================================================
# GLO-NCA — .gitignore: generated output, local data, caches, secrets and the
# local-only extra/ folder. Source, configs, scripts and the master split stay tracked.
# =============================================================================

# --- Python / environments ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# --- Medical data (never commit) ---
*.nii
*.nii.gz
data/
brats_dl/
scratch_brats/
**/BraTS*dataset*/
Tutorial/Data/

# --- Experiment outputs / checkpoints / logs (generated) ---
# Root-anchored so only the top-level output directory is ignored.
/experiments/
# Profiling artifacts (large traces).
/experiments/phase2_profiling/
# Deterministic preprocessing cache (regenerable; ~40 MB/case at 128^3).
.cache/
**/profiler/*.pt.trace.json
runs/
compare_runs/
out/
/Models/
*.pth
*.pbz2
tensorboard/
*.tfevents.*
events.out.tfevents.*
*.log

# --- Secrets / machine-specific (never commit) ---
cloud/config/gcp.env
*.pem
*.key
*-service-account*.json
gcp-key*.json
.claude/settings.local.json

# --- Local build/transfer artifacts ---
*.tar.gz
*.zip

# --- OS / IDE ---
.DS_Store
.vscode/
.idea/

# --- Notebooks scratch ---
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Keep the master split tracked (case IDs only, no data) so the thesis split is
# archived in git.
# -----------------------------------------------------------------------------
!split/master_split.json
.trash_md_review/
.trash_cleanup/

# --- Local-only material (tests, reports, docs, historical configs) ------------
# Not versioned and not needed at runtime; .dockerignore also excludes it.
/extra/

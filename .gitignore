# =============================================================================
# GLO-NCA — .gitignore
# Ignore generated output, local data, caches and secrets. Keep all source,
# configs, scripts, docs, the master split and reproducibility evidence tracked.
# =============================================================================

# --- Python / environments ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# --- Medical data (never commit) ---
*.nii
*.nii.gz
data/
brats_dl/
scratch_brats/
**/BraTS*dataset*/
Tutorial/Data/

# --- Experiment outputs / checkpoints / logs (generated) ---
experiments/
# Phase 2 profiling artifacts (traces can be large; never commit them)
experiments/phase2_profiling/
# Deterministic preprocessing cache (regenerable; ~38 MB/case at 128^3)
.cache/
**/profiler/*.pt.trace.json
runs/
compare_runs/
out/
/Models/
*.pth
*.pbz2
tensorboard/
*.tfevents.*
events.out.tfevents.*
*.log

# --- Secrets / machine-specific (never commit) ---
cloud/config/gcp.env
*.pem
*.key
*-service-account*.json
gcp-key*.json
.claude/settings.local.json

# --- Local build/transfer artifacts ---
*.tar.gz
*.zip

# --- OS / IDE ---
.DS_Store
.vscode/
.idea/

# --- Notebooks scratch ---
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Explicitly KEEP (tracked) despite broader patterns above:
#   - split/master_split.json  (case-IDs only; required for reproducibility)
#   - configs/*.yaml, src/**, scripts/**, docs/**, reports/**/*.md
# The master split is data-free (patient/case IDs only) and is committed on
# purpose so the exact thesis split is archived in git.
# -----------------------------------------------------------------------------
!split/master_split.json
.trash_md_review/
.trash_cleanup/

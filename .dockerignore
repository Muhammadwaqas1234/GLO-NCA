# Keep the training image small: it needs only what the Dockerfile COPYs
# (src/, configs/, scripts/, split files, train.py, requirements-docker.txt,
# constraints-docker.txt).

# --- VCS / IDE / OS ---
.git/
.gitignore
.github/
.vscode/
.idea/
.claude/
.DS_Store

# --- Python caches / envs ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# --- Notebooks / experiment history not needed for training ---
*.ipynb
.ipynb_checkpoints/
kaggle_v*.py
extra/

# --- Data / outputs / artifacts (mounted at run time, never baked in) ---
scratch_brats/
out/
*.pth
*.nii
*.nii.gz
*.png
*.json
!split/master_split.json
!split/data_quality_policy.json
*.dt
events.out.tfevents.*

# --- Docs / misc ---
*.md
LICENSE
requirements.txt

experiments/
scratch_brats/
# Local preprocessing cache (can be many GB; the VM mounts its own at run time).
.cache/

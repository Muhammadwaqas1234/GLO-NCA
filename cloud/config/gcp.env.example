# =============================================================================
# GLO-NCA V2 -- GCP configuration (EXAMPLE).
#
# Copy this to cloud/config/gcp.env and fill in your values. The real file
# (cloud/config/gcp.env) is git-ignored and must NEVER be committed.
#
# No secrets belong here: use the VM's attached service account / Application
# Default Credentials for authentication, not JSON keys. A project ID is not a
# secret, but keep this file out of git anyway (it is your machine's config).
# =============================================================================

# --- GCP project / location ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# --- Cloud Storage (durable source of truth) ---
GCS_BUCKET=glo-nca-v2-yourname          # bucket name only, no gs:// prefix
DATA_PREFIX=datasets/brats              # dataset location inside the bucket
EXPERIMENT_PREFIX=experiments           # experiment outputs inside the bucket

# --- GPU VM ---
# GPU choice depends on the run:
#   * V2 (patch 96):        T4 16GB is enough (cheapest).
#   * V3 (128^3 fine level): the memory driver is the 128^3 activation volume.
#     T4 16GB is TIGHT and may NOT be a genuine TRUE FIT -- L4 24GB (G2) is the
#     recommended low-cost choice with headroom. ALWAYS confirm with
#     `python scripts/gpu_memory_gate_v3.py --config configs/v3_multilevel.yaml`
#     (must report 96^3 AND 128^3 TRUE FIT) before the 300-epoch run. Never
#     reduce the V3 architecture to fit a smaller GPU.
VM_NAME=glo-nca-gpu
# For V3: MACHINE_TYPE=g2-standard-8 with GPU_TYPE=nvidia-l4 (G2 family pairs L4).
MACHINE_TYPE=g2-standard-8             # L4 pairing for V3 (use n1-standard-8 for T4/V2)
GPU_TYPE=nvidia-l4                     # V3 recommended (24GB); nvidia-tesla-t4 for V2
GPU_COUNT=1
DISK_SIZE_GB=200                        # boot+data disk; see storage design

# --- provisioning mode ---
# SPOT is preemptible and roughly 3x cheaper (~$0.25-0.35/h vs ~$0.85-0.90/h
# for a single L4 at list price; confirm current rates before a long run).
#
# Spot is safe for this workload: last.pth is written every epoch, periodic
# snapshots every 5 (logging.checkpoint_frequency), and a background watcher
# rsyncs the experiment directory to GCS every GLO_SYNC_INTERVAL seconds
# (default 300), so a preemption costs at most one sync interval. The
# termination action is STOP, so the instance and its disk survive and
# start_vm.sh restarts the SAME VM; resume_training.sh then continues from
# last.pth with optimizer, scheduler, EMA, epoch, step and early-stopping
# patience restored.
#
# Trade-off: Spot capacity is not guaranteed. If L4 Spot is unavailable in the
# zone, creation fails and you either wait or switch to STANDARD.
PROVISIONING_MODEL=STANDARD             # STANDARD (on-demand) | SPOT
# A GPU-ready base image with the NVIDIA driver preinstalled. The Deep Learning
# VM images ship a recent driver + Docker + NVIDIA Container Toolkit.
IMAGE_FAMILY=common-cu121-debian-11
IMAGE_PROJECT=deeplearning-platform-release

# --- VM-local paths (inside the VM) ---
VM_WORKSPACE=/opt/glo-nca                # repo checkout on the VM
VM_DATA_DIR=/data                        # local dataset cache (synced from GCS)
VM_OUT_DIR=/out                          # experiments base (synced to GCS)

# --- behaviour ---
SYNC_INTERVAL_SECONDS=300                # background GCS sync cadence during training

# =============================================================================
# GLO-NCA -- GCP configuration (EXAMPLE).
#
# Copy to cloud/config/gcp.env (git-ignored; never commit it) and fill in values.
# No secrets here: authenticate with the VM service account / ADC, not JSON keys.
# =============================================================================

# --- GCP project / location ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# --- Cloud Storage (durable source of truth) ---
GCS_BUCKET=glo-nca-yourname             # bucket name only, no gs:// prefix
DATA_PREFIX=datasets/brats              # dataset location inside the bucket
EXPERIMENT_PREFIX=experiments           # experiment outputs inside the bucket

# --- GPU VM ---
# L4 24GB (G2) is the recommended GPU for two-level GLO-NCA at a 128^3 working
# volume; pretrain_gate.sh confirms the fit with the real-data smoke before a run.
VM_NAME=glo-nca-gpu
# G2 machine types pair with the L4.
MACHINE_TYPE=g2-standard-8             # L4 pairing
GPU_TYPE=nvidia-l4                     # 24GB, recommended
GPU_COUNT=1
DISK_SIZE_GB=200                        # boot+data disk; see storage design

# --- provisioning mode ---
# SPOT is preemptible and roughly 3x cheaper (~$0.25-0.35/h vs ~$0.85-0.90/h
# for a single L4 at list price; confirm current rates before a long run).
#
# Spot is safe here: last.pth is written every epoch and the experiment dir is
# synced to GCS every SYNC_INTERVAL_SECONDS, so a preemption costs at most one
# sync interval. Termination action is STOP; start_vm.sh restarts the same VM and
# resume_training.sh restores optimizer, scheduler, EMA and early-stopping state.
#
# Spot capacity is not guaranteed; if L4 Spot is unavailable, wait or use STANDARD.
PROVISIONING_MODEL=STANDARD             # STANDARD (on-demand) | SPOT
# Deep Learning VM image: NVIDIA driver, Docker and the container toolkit preinstalled.
IMAGE_FAMILY=common-cu121-debian-11
IMAGE_PROJECT=deeplearning-platform-release

# --- VM-local paths (inside the VM) ---
VM_WORKSPACE=/opt/glo-nca                # repo checkout on the VM
VM_DATA_DIR=/data                        # local dataset cache (synced from GCS)
VM_OUT_DIR=/out                          # experiments base (synced to GCS)
VM_CACHE_DIR=/cache                      # persistent preprocessing cache (mounted at /app/.cache)

# --- behaviour ---
SYNC_INTERVAL_SECONDS=300                # background GCS sync cadence during training

# GCP settings for GLO-NCA cascade; copy to cloud/config/gcp.env (git-ignored) and fill in.

# --- GCP project / location ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# --- Cloud Storage ---
GCS_BUCKET=glo-nca-yourname             # bucket name only, no gs:// prefix
EXPERIMENT_PREFIX=experiments           # run outputs inside the bucket

# --- GPU VM (can be the same VM as production GLO-NCA) ---
VM_NAME=glo-nca-gpu
MACHINE_TYPE=g2-standard-8              # L4 pairing
GPU_TYPE=nvidia-l4                      # 24GB
GPU_COUNT=1
DISK_SIZE_GB=200
PROVISIONING_MODEL=SPOT                 # SPOT (cheaper, preemptible) | STANDARD
IMAGE_FAMILY=common-cu121-debian-11
IMAGE_PROJECT=deeplearning-platform-release

# --- VM-local paths ---
GLO_WORKSPACE=/opt/glo-nca-cascade            # cascade checkout (separate from production)
GLO_BRANCH=glo-nca-cascade
GLO_DATA_ROOT=/data/brats                # searched for the BraTS case folders
VM_OUT_DIR=/out                         # runs are written here and synced to GCS

# --- behaviour ---
SYNC_INTERVAL_SECONDS=300               # background GCS sync cadence during training

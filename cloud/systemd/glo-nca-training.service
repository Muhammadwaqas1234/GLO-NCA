# GLO-NCA training service (installed by run_training.sh on the GPU VM).
# Survives SSH disconnect. Restart=no: a finished or failed run is never looped;
# recovery is a deliberate resume_training.sh.
[Unit]
Description=GLO-NCA training (Docker, GPU)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/glo-nca.env
# The repo path is in the env file; the wrapper reads /etc/glo-nca.env itself.
# Run through bash so the unit does not depend on the script's executable bit.
ExecStart=/bin/bash -lc 'exec /bin/bash "${GLO_REPO}"/cloud/scripts/_train_entrypoint.sh'
Restart=no
# Long stop timeout so an in-flight checkpoint write can finish.
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
